# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# IDE & Editor settings
.vscode/
.idea/
.vs/
*.swp
*.swo

# Local workspace metadata
.workbuddy/
.system_generated/

# PyInstaller build artifacts
build/
dist/
bilibili_resell_monitor.spec
*.exe

# buildozer build artifacts (spec file must be tracked!)
android_app/.buildozer/
.buildozer-global/
android_app/bin/

# adb crash log capture
platform-tools/
platform-tools.zip
crash_log.txt

# Local notification & theme credentials/configs (secrets & runtime state)
notify_config.json
*theme_config.json

# 服务器部署配置（含公网 IP、密钥路径，禁止入库）
deploy.conf

# 本机做服务器时的敏感配置与运行产物
# 注意：gitignore 不支持行尾注释，注释必须单独占一行
auth.conf
ddns.conf
schedule_config.json
logs/
.last_ipv6

# 商品图片本地缓存（运行时自动生成，体积随商品数增长，不入库）
cache/

# 采集产物与业务数据（每次抓取都会变更，且历史库已达 38MB，会把 .git 撑大）
# 首次克隆后这些文件为空属正常：跑一次抓取即生成，价格轨迹从备份恢复
# 不含斜杠，android_app/ 下的同名文件一并忽略
3c_products.json
3c_products.csv
3c_products_history.csv
deals_cache.json
pushed_alerts.json
